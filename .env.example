# All optional. With none of these set, Hearth runs fully offline except the live CPSC recall lookup
# (which falls back to a bundled snapshot in data/recalls-fixture.json).
PORT=3939
HEARTH_DB=data/hearth.db
# HEARTH_AUTH=off            # disable OAuth for quick curl experiments
# PUBLIC_URL=https://hearth.example.com   # behind a tunnel/proxy, so OAuth metadata is correct

# Amazon Bedrock brain for the simulated Alexa+ (any standard AWS credential source also works)
# HEARTH_AGENT=bedrock       # force on ("local" forces the offline router)
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Free-plan guard: hard cap on Bedrock calls per UTC day (default 150, persisted in the database)
# HEARTH_BEDROCK_DAILY_CALLS=150
