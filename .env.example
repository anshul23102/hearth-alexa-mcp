# Every setting Hearth reads. All are optional; with none set it runs locally with sensible defaults.

# --- server ---------------------------------------------------------------------------------------------
PORT=3939
HEARTH_DB=data/hearth.db
# PUBLIC_URL=https://hearth.example.com        # needed behind a domain/tunnel so OAuth metadata is correct
# HEARTH_ALLOWED_HOSTS=hearth.example.com      # extra Host headers to accept (DNS-rebinding defence)
# HEARTH_ALLOWED_ORIGINS=https://app.example.com   # extra browser origins allowed to call the API
# HEARTH_TRUST_PROXY=1                         # trust X-Forwarded-For for rate limits (only behind your own proxy)
# HEARTH_AUTH=off                              # local curl experiments only: everyone becomes the "demo" household
# HEARTH_MAX_UPLOAD_MB=250                     # cap for POST /api/import
# HEARTH_MAX_CONCURRENT_IMPORTS=3              # bulk imports running at once; more get 503 + Retry-After
# HEARTH_MAX_SESSIONS_PER_HOUSEHOLD=20         # open MCP sessions per household before its oldest is closed

# --- safety ceilings (major units of the order's currency; the model cannot change these) ---------------
# HEARTH_MAX_ORDER=500
# HEARTH_MAX_DAILY=1500

# --- rate limits (per client address, fixed window) ------------------------------------------------------
# HEARTH_RATE_REGISTER=20        # client registrations per hour
# HEARTH_RATE_TOKEN=60           # token requests per minute
# HEARTH_RATE_AUTHORIZE=60       # consent page requests per minute

# --- operations (each endpoint is OFF, returning 404, unless its token is set) --------------------------------
# HEARTH_METRICS_TOKEN=          # 16+ chars: enables GET /metrics (Prometheus) with this bearer token
# HEARTH_ADMIN_TOKEN=            # 24+ chars: enables POST /api/admin/recalls/replay (used by `npm run demo:recall`) and POST /api/admin/reminders/run
# HEARTH_REMIND_AFTER_HOURS=72   # a likely recall still open after this long comes back as a reminder (at most three times); 0 reminds on the next pass
# HEARTH_URL=http://localhost:3939   # where `npm run demo:recall` sends the command

# --- recall index ---------------------------------------------------------------------------------------------
# HEARTH_RECALLS_SYNC=off        # never sync feeds in the background (tests, air-gapped runs)
# HEARTH_RECALLS_OFFLINE=1       # never touch the network; use the bundled snapshot in data/ (tests)

# --- Amazon Bedrock brain for the simulated Alexa+ (optional) ---------------------------------------------------
# Credentials come from the standard AWS chain (AWS_PROFILE after `aws sso login`, AWS_ACCESS_KEY_ID/SECRET, or
# a Bedrock API key in AWS_BEARER_TOKEN_BEDROCK). Never commit them.
# HEARTH_AGENT=bedrock           # force on; "local" forces the offline router
# AWS_REGION=ap-southeast-2      # free-plan accounts are locked to their home region
# BEDROCK_MODEL_ID=au.anthropic.claude-haiku-4-5-20251001-v1:0   # verified on a free-plan Sydney account; the prefix must match the region (au./us./eu./apac.)
# HEARTH_BEDROCK_ENDPOINT=         # test-only: send Bedrock calls to a stand-in server
# HEARTH_BEDROCK_DAILY_CALLS=150   # hard cap on model calls per UTC day, persisted in the database
