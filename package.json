{
  "name": "hearth-alexa-mcp",
  "version": "0.1.0",
  "description": "Hearth: recall alerts and safe reordering for Alexa+. A self-hosted MCP server (2025-11-25, Streamable HTTP, OAuth 2.1 + PKCE) that tells households the day a product they own is recalled and never spends money without an explicit, undoable yes.",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "start": "tsx src/http.ts",
    "sample": "tsx scripts/make-sample.ts",
    "typecheck": "tsc -p .",
    "bedrock:check": "tsx scripts/bedrock-check.ts",
    "demo:recall": "tsx scripts/replay-recall.ts",
    "build": "tsc -p tsconfig.build.json && cp src/view.html dist/view.html",
    "start:prod": "node dist/http.js",
    "backup": "tsx scripts/backup.ts",
    "bench": "tsx scripts/bench.ts",
    "eval": "tsx scripts/eval-recalls.ts",
    "bedrock:probe": "tsx scripts/bedrock-probe.ts",
    "gallery": "node scripts/make-gallery.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "alexa",
    "alexa-plus",
    "agent",
    "recalls",
    "consumer-safety",
    "amazon-bedrock",
    "claude",
    "oauth",
    "streamable-http",
    "sqlite"
  ],
  "author": "anshul23102",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1154.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anshul23102/hearth-alexa-mcp.git"
  },
  "homepage": "https://github.com/anshul23102/hearth-alexa-mcp#readme",
  "bugs": {
    "url": "https://github.com/anshul23102/hearth-alexa-mcp/issues"
  }
}
