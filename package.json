{
  "name": "hearth-alexa-mcp",
  "version": "0.1.0",
  "description": "Hearth: recall alerts and safe reordering for Alexa+, as a stateful MCP server",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "start": "tsx src/http.ts",
    "sample": "tsx scripts/make-sample.ts",
    "typecheck": "tsc -p .",
    "bedrock:check": "tsx scripts/bedrock-check.ts",
    "demo:recall": "tsx scripts/replay-recall.ts",
    "build": "tsc -p tsconfig.build.json && cp src/view.html dist/view.html",
    "start:prod": "node dist/http.js",
    "backup": "tsx scripts/backup.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1154.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
